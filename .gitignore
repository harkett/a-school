.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
outputs/
data/
# Frontend
node_modules/
frontend/dist/
frontend/node_modules/
# Runtime
backend.pid
frontend.pid
.run_pids
# Sauvegardes locales .bak (filets avant edition/suppression) — jamais commitees
*.bak-*
# Scripts ephemeres (regle « script ephemere » : jamais commites)
_tmp_*.py
# Dossiers ephemeres (_tmp_...) : artefacts de travail, jamais commites
_tmp_*/
# Carte de la base : sortie regeneree a la demande (on la reconstruit, jamais versionnee)
outils_bdd/carte_base/carte_base.html
# Referentiels : PDF/extractions generes et remanies pendant les tests (artefacts, hors depot)
REFERENTIELS/
# Apercu HTML genere depuis un .md (« enregistrer sous » — artefact, hors depot)
Scripts/bilan.html
# Config editeur perso VS Code (workspace local, hors depot)
A-SCHOOL.code-workspace
# Docker local (base + caches, 4,4 Go) — donnees locales du poste, JAMAIS en depot ni sur le serveur.
# EXCEPTION : docker/initdb/*.sql. Ce n'est pas une donnee du poste, c'est l'amorcage de la base,
# monte par docker-compose dans les deux services (lignes 25 et 48). Sans lui, une installation
# neuve demarre un Postgres SANS l'extension vector, et `alembic upgrade head` casse a la premiere
# colonne VECTOR. Il doit voyager avec le depot. `docker/*` (et non `docker/`) pour que git puisse
# descendre dans le dossier et voir l'exception.
docker/*
!docker/initdb/
!docker/initdb/*.sql
# Sauvegarde de la base (dump local) — donnees, JAMAIS sur un depot public
db_backup/
# Bagage/ : le travail que je_pars.ps1 fait entrer dans le dossier pour la bascule
# A <-> B. Ce sont des DONNEES, elles voyagent par la COPIE DU DOSSIER, jamais par
# le depot (un binaire complet ajoute a l'historique a chaque bascule).
Bagage/
# Cache disque des reponses LLM (dev, LLM_CACHE=1) : evite de repayer la meme decoupe a chaque
# essai. Ce sont des reponses de modele et les prompts qui les ont produites — artefacts de
# travail d'un poste, jamais du depot. Purge = supprimer le dossier.
.llm_cache/

# Filets locaux .bak (avant edition/suppression) — jamais commites
*.bak

# Dumps de deploiement — ecrits par Scripts\deployer-donnees.ps1, envoyes par SCP au VPS.
# JAMAIS dans git : ce sont les DONNEES (des dizaines de Mo, et les comptes des profs).
# `deploy.ps1` fait `git add .` : sans cette ligne, le premier deploiement de donnees pousserait
# la base entiere sur GitHub.
deploy/dumps/
# Ecrits par deploy/installer-demos.sh sur le serveur, a partir de deploy/demos.conf.
deploy/env-demos/
Scripts/.recette.env
